<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Данные преступления"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <EditText
            android:id="@+id/crime_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название преступления" />

        <EditText
            android:id="@+id/crime_suspect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя подозреваемого" />

        <TextView
            android:id="@+id/crime_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дата преступления"
            android:textSize="16sp"
            android:padding="12dp" />

        <CheckBox
            android:id="@+id/crime_solved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Преступление раскрыто" />

        <Button
            android:id="@+id/save_crime_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить" />

        <Button
            android:id="@+id/select_contact_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбрать контакт" />

        <Button
            android:id="@+id/call_suspect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Позвонить" />

    </LinearLayout>

</ScrollView>
